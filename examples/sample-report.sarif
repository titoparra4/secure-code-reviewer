{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Secure Code Reviewer",
          "semanticVersion": "1.1.0",
          "informationUri": "https://github.com/titoparra4/secure-code-reviewer",
          "rules": [
            {
              "id": "secrets.connection-string-password",
              "name": "CredentialsInDatabaseBrokerConnectionString",
              "shortDescription": {
                "text": "Credentials in database/broker connection string"
              },
              "fullDescription": {
                "text": "A value matching the 'connection-string-password' pattern was found. The value is redacted. If it is real: revoke/rotate it and review provider logs for misuse."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/798.html",
              "help": {
                "text": "Remove the value from source, load it from a secret manager or environment, and if it is (or may be) real: revoke/rotate it, review usage logs for abuse and purge it from git history."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-798",
                  "Secrets Exposure"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "injection.sql.string-built-query",
              "name": "SqlQueryBuiltWithStringInterpolation",
              "shortDescription": {
                "text": "SQL query built with string interpolation"
              },
              "fullDescription": {
                "text": "A SQL statement is built by string formatting/concatenation instead of bound parameters."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/89.html",
              "help": {
                "text": "Use parameterized queries / prepared statements or the ORM query builder. Never interpolate values into SQL; allow-list identifiers (column/table names) if they must be dynamic."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-89",
                  "SQL Injection"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "agent.insecure-direct-object-reference-on-invoice-retrieval",
              "name": "InsecureDirectObjectReferenceOnInvoiceRetrieval",
              "shortDescription": {
                "text": "Insecure Direct Object Reference on invoice retrieval"
              },
              "fullDescription": {
                "text": "The handler loads an invoice by the path parameter invoice_id and returns it without checking that the invoice belongs to the authenticated user. No authorization decorator or ownership filter exists on this route or in a before_request hook (reviewed app/app.py in full)."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/639.html",
              "help": {
                "text": "Scope the query to the current user (WHERE id = ? AND owner_id = ?) and return 404 when the invoice is not owned by the caller. Centralize the check in a reusable authorization helper."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-639",
                  "Broken Access Control"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "injection.command.python",
              "name": "OsCommandExecutionThroughAShell",
              "shortDescription": {
                "text": "OS command execution through a shell"
              },
              "fullDescription": {
                "text": "An OS command is executed through a shell or with a dynamically built command string."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/78.html",
              "help": {
                "text": "Avoid the shell: pass an argument list (shell=False / execFile / ProcessBuilder with separate args), validate input against an allow-list and prefer native libraries over shelling out."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-78",
                  "Command Injection"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "deserialization.python",
              "name": "UnsafeDeserializationPickleMarshalYamlLoad",
              "shortDescription": {
                "text": "Unsafe deserialization (pickle/marshal/yaml.load)"
              },
              "fullDescription": {
                "text": "Data is deserialized with a format/loader that can instantiate arbitrary objects."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/502.html",
              "help": {
                "text": "Use data-only formats (JSON) or safe loaders (yaml.safe_load). If native serialization is unavoidable, sign/authenticate the payload and restrict allowed types."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-502",
                  "Insecure Deserialization"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "auth.jwt.signature-not-verified",
              "name": "JwtDecodedWithoutSignatureVerification",
              "shortDescription": {
                "text": "JWT decoded without signature verification"
              },
              "fullDescription": {
                "text": "JWT validation is weakened (signature, algorithm or claim checks disabled)."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/347.html",
              "help": {
                "text": "Always verify the signature with an explicit algorithm allow-list, and validate exp, nbf, iss and aud."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-347",
                  "Broken Authentication (JWT)"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "crypto.weak-hash",
              "name": "WeakPasswordHashingFastUnsaltedHash",
              "shortDescription": {
                "text": "Weak password hashing (fast, unsalted hash)"
              },
              "fullDescription": {
                "text": "A weak hash algorithm (MD5/SHA-1) is used."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/916.html",
              "help": {
                "text": "For passwords use Argon2id, scrypt or bcrypt with per-user salt; for integrity use SHA-256+ or HMAC."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-916",
                  "Insecure Cryptography"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "injection.command.node",
              "name": "ChildProcessExecWithADynamicCommand",
              "shortDescription": {
                "text": "child_process exec with a dynamic command"
              },
              "fullDescription": {
                "text": "An OS command is executed through a shell or with a dynamically built command string."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/78.html",
              "help": {
                "text": "Avoid the shell: pass an argument list (shell=False / execFile / ProcessBuilder with separate args), validate input against an allow-list and prefer native libraries over shelling out."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-78",
                  "Command Injection"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "container.dangerous-capabilities",
              "name": "DangerousLinuxCapabilitiesAdded",
              "shortDescription": {
                "text": "Dangerous Linux capabilities added"
              },
              "fullDescription": {
                "text": "The container/workload runs with elevated privileges or host access."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/250.html",
              "help": {
                "text": "Run as a non-root user, drop all capabilities, forbid privilege escalation, avoid host namespaces and the Docker socket, and enable a read-only root filesystem."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-250",
                  "Container Security"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "iac.storage.public-acl",
              "name": "StorageMadePubliclyAccessible",
              "shortDescription": {
                "text": "Storage made publicly accessible"
              },
              "fullDescription": {
                "text": "Storage or data service is publicly accessible or unencrypted."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/732.html",
              "help": {
                "text": "Block public access, enable encryption at rest and in transit, and use least-privilege access policies."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-732",
                  "Infrastructure Exposure"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "container.privileged",
              "name": "PrivilegedContainer",
              "shortDescription": {
                "text": "Privileged container"
              },
              "fullDescription": {
                "text": "The container/workload runs with elevated privileges or host access."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/250.html",
              "help": {
                "text": "Run as a non-root user, drop all capabilities, forbid privilege escalation, avoid host namespaces and the Docker socket, and enable a read-only root filesystem."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-250",
                  "Container Security"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "container.docker-socket-mount",
              "name": "DockerSocketMountedIntoAContainer",
              "shortDescription": {
                "text": "Docker socket mounted into a container"
              },
              "fullDescription": {
                "text": "The container/workload runs with elevated privileges or host access."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/250.html",
              "help": {
                "text": "Run as a non-root user, drop all capabilities, forbid privilege escalation, avoid host namespaces and the Docker socket, and enable a read-only root filesystem."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-250",
                  "Container Security"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "cicd.gha.script-injection",
              "name": "UntrustedGithubEventDataInterpolatedIntoAScript",
              "shortDescription": {
                "text": "Untrusted GitHub event data interpolated into a script"
              },
              "fullDescription": {
                "text": "CI/CD workflow configuration allows untrusted input or excessive privileges."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/94.html",
              "help": {
                "text": "Use least-privilege `permissions:`, never interpolate untrusted event fields into `run:` (use env vars), avoid checking out PR code in pull_request_target, and pin actions to full commit SHAs."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-94",
                  "CI/CD Security"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "secrets.generic-secret-assignment",
              "name": "HardcodedSecretOrPassword",
              "shortDescription": {
                "text": "Hardcoded secret or password"
              },
              "fullDescription": {
                "text": "A value matching the 'generic-secret-assignment' pattern was found. The value is redacted. If it is real: revoke/rotate it and review provider logs for misuse."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/798.html",
              "help": {
                "text": "Remove the value from source, load it from a secret manager or environment, and if it is (or may be) real: revoke/rotate it, review usage logs for abuse and purge it from git history."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-798",
                  "Secrets Exposure"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "path-traversal.user-path",
              "name": "FilePathBuiltFromRequestInput",
              "shortDescription": {
                "text": "File path built from request input"
              },
              "fullDescription": {
                "text": "A filesystem path is built from request input."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/22.html",
              "help": {
                "text": "Resolve the final path and verify it stays inside the base directory; prefer opaque identifiers mapped server-side; use safe helpers (send_from_directory, secure_filename)."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-22",
                  "Path Traversal"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "ssrf.user-controlled-url",
              "name": "OutboundRequestToAUserControlledUrl",
              "shortDescription": {
                "text": "Outbound request to a user-controlled URL"
              },
              "fullDescription": {
                "text": "An outbound HTTP request uses a URL derived from user input."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/918.html",
              "help": {
                "text": "Allow-list destination hosts/schemes, resolve and block private/link-local ranges, disable redirects or re-validate them, and enforce egress controls."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-918",
                  "Server-Side Request Forgery"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "xss.server-reflected",
              "name": "RequestInputReflectedInAnHtmlResponse",
              "shortDescription": {
                "text": "Request input reflected in an HTML response"
              },
              "fullDescription": {
                "text": "Data is written into HTML without context-aware escaping, or escaping is explicitly disabled."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/79.html",
              "help": {
                "text": "Rely on framework auto-escaping, use textContent instead of innerHTML, sanitize rich HTML with a vetted sanitizer (e.g. DOMPurify) and deploy a strict Content-Security-Policy."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-79",
                  "Cross-Site Scripting (XSS)"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "supply-chain.remote-script-pipe",
              "name": "RemoteScriptPipedToAShell",
              "shortDescription": {
                "text": "Remote script piped to a shell"
              },
              "fullDescription": {
                "text": "A remote script is downloaded and executed without integrity verification."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/494.html",
              "help": {
                "text": "Download to a file, verify a pinned checksum or signature, then execute; prefer package managers."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-494",
                  "Supply Chain"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "container.host-namespaces",
              "name": "HostNetworkPidIpcNamespaceShared",
              "shortDescription": {
                "text": "Host network/PID/IPC namespace shared"
              },
              "fullDescription": {
                "text": "The container/workload runs with elevated privileges or host access."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/250.html",
              "help": {
                "text": "Run as a non-root user, drop all capabilities, forbid privilege escalation, avoid host namespaces and the Docker socket, and enable a read-only root filesystem."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-250",
                  "Container Security"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "container.runs-as-root-k8s",
              "name": "WorkloadConfiguredToRunAsRoot",
              "shortDescription": {
                "text": "Workload configured to run as root"
              },
              "fullDescription": {
                "text": "The container/workload runs with elevated privileges or host access."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/250.html",
              "help": {
                "text": "Run as a non-root user, drop all capabilities, forbid privilege escalation, avoid host namespaces and the Docker socket, and enable a read-only root filesystem."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-250",
                  "Container Security"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "container.privilege-escalation",
              "name": "AllowprivilegeescalationEnabled",
              "shortDescription": {
                "text": "allowPrivilegeEscalation enabled"
              },
              "fullDescription": {
                "text": "The container/workload runs with elevated privileges or host access."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/250.html",
              "help": {
                "text": "Run as a non-root user, drop all capabilities, forbid privilege escalation, avoid host namespaces and the Docker socket, and enable a read-only root filesystem."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-250",
                  "Container Security"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "iac.encryption-disabled",
              "name": "EncryptionAtRestInTransitDisabled",
              "shortDescription": {
                "text": "Encryption at rest/in transit disabled"
              },
              "fullDescription": {
                "text": "Storage or data service is publicly accessible or unencrypted."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/311.html",
              "help": {
                "text": "Block public access, enable encryption at rest and in transit, and use least-privilege access policies."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-311",
                  "Infrastructure Exposure"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "webserver.legacy-tls",
              "name": "LegacyTlsSslProtocolEnabled",
              "shortDescription": {
                "text": "Legacy TLS/SSL protocol enabled"
              },
              "fullDescription": {
                "text": "Legacy TLS/SSL protocol versions or weak ciphers are enabled."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/326.html",
              "help": {
                "text": "Allow only TLS 1.2 and 1.3 with modern cipher suites."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-326",
                  "Insecure Transport"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "dependencies.wildcard-version",
              "name": "WildcardLatestDependencyVersionCors",
              "shortDescription": {
                "text": "Wildcard/latest dependency version: cors"
              },
              "fullDescription": {
                "text": "Any future release (including a compromised one) will be installed automatically."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/1357.html",
              "help": {
                "text": "Pin images to a version tag and preferably a digest (image@sha256:...), and update via automated PRs."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-1357",
                  "Dependency Security"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "dependencies.untrusted-source",
              "name": "DependencyInstalledFromVcsUrlInternalUtils",
              "shortDescription": {
                "text": "Dependency installed from VCS/URL: internal-utils"
              },
              "fullDescription": {
                "text": "Dependency resolved from a git/URL/path source bypasses registry integrity controls and may change without a version bump."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/829.html",
              "help": {
                "text": "Prefer a released registry version pinned with a lockfile/hash; if a VCS source is required, pin to a full commit SHA."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-829",
                  "Dependency Security"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "crypto.insecure-random",
              "name": "NonCryptographicPrngForASecurityValue",
              "shortDescription": {
                "text": "Non-cryptographic PRNG for a security value"
              },
              "fullDescription": {
                "text": "A non-cryptographic PRNG appears to generate a security-sensitive value."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/338.html",
              "help": {
                "text": "Use a CSPRNG: secrets.token_urlsafe (Python), crypto.randomBytes / crypto.randomUUID (Node), SecureRandom (Java), RandomNumberGenerator (.NET)."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-338",
                  "Insecure Randomness"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "config.debug-enabled",
              "name": "DebugModeEnabled",
              "shortDescription": {
                "text": "Debug mode enabled"
              },
              "fullDescription": {
                "text": "Debug mode or developer error pages are enabled."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/489.html",
              "help": {
                "text": "Drive debug flags from environment configuration and default to off in production."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-489",
                  "Security Misconfiguration"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "config.cors-wildcard",
              "name": "CorsAllowsAnyOrigin",
              "shortDescription": {
                "text": "CORS allows any origin"
              },
              "fullDescription": {
                "text": "CORS allows any origin."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/942.html",
              "help": {
                "text": "Allow-list trusted origins; never combine wildcard/reflected origins with credentials."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-942",
                  "Security Misconfiguration"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "mass-assignment.request-body-binding",
              "name": "ModelBoundDirectlyToRequestBody",
              "shortDescription": {
                "text": "Model bound directly to request body"
              },
              "fullDescription": {
                "text": "A model/object is created or updated directly from the request body."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/915.html",
              "help": {
                "text": "Map input through an explicit allow-list or DTO/schema; never bind the raw body to persistence models."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-915",
                  "Mass Assignment"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "auth.jwt.decode-without-verify-node",
              "name": "JsonwebtokenDecodeDoesNotVerifySignatures",
              "shortDescription": {
                "text": "jsonwebtoken decode() does not verify signatures"
              },
              "fullDescription": {
                "text": "JWT validation is weakened (signature, algorithm or claim checks disabled)."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/347.html",
              "help": {
                "text": "Always verify the signature with an explicit algorithm allow-list, and validate exp, nbf, iss and aud."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-347",
                  "Broken Authentication (JWT)"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "errors.stack-trace-in-response",
              "name": "ExceptionDetailsReturnedToTheClient",
              "shortDescription": {
                "text": "Exception details returned to the client"
              },
              "fullDescription": {
                "text": "Exception details or stack traces are returned to the client."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/209.html",
              "help": {
                "text": "Return generic error messages with a correlation id and log details server-side."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-209",
                  "Insecure Error Handling"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "iac.network.open-to-world",
              "name": "IngressOpenTo00000",
              "shortDescription": {
                "text": "Ingress open to 0.0.0.0/0"
              },
              "fullDescription": {
                "text": "A resource is exposed to the internet or allows unrestricted network access."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/284.html",
              "help": {
                "text": "Restrict CIDR ranges to known networks, place services behind load balancers/WAF and use private subnets."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-284",
                  "Infrastructure Exposure"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "container.docker.unpinned-base-image",
              "name": "BaseImageNotPinnedLatestOrNoTag",
              "shortDescription": {
                "text": "Base image not pinned (latest or no tag)"
              },
              "fullDescription": {
                "text": "The base image is not pinned to a specific version/digest."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/1357.html",
              "help": {
                "text": "Pin images to a version tag and preferably a digest (image@sha256:...), and update via automated PRs."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-1357",
                  "Supply Chain"
                ],
                "security-severity": "3.0"
              }
            },
            {
              "id": "webserver.directory-listing",
              "name": "DirectoryListingEnabled",
              "shortDescription": {
                "text": "Directory listing enabled"
              },
              "fullDescription": {
                "text": "Web server configuration discloses information (directory listing, version banners)."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/548.html",
              "help": {
                "text": "Disable directory listing and version banners."
              },
              "properties": {
                "tags": [
